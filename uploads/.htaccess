# در این پوشه هیچ اسکریپتی اجرا نمی‌شه، فقط عکس و صدا سرو می‌شن
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
